{
  "name": "yolo-labeler",
  "version": "1.0.2",
  "description": "简洁易用的 YOLO 格式矩形框标注工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:dir": "electron-builder --dir",
    "clean": "rm -rf dist",
    "release": "pnpm clean && electron-builder --win --publish always"
  },
  "keywords": [
    "yolo",
    "labeling",
    "annotation",
    "object-detection"
  ],
  "author": "Chris",
  "license": "MIT",
  "homepage": "https://github.com/Cupcc/YOLO-Labeler",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cupcc/YOLO-Labeler.git"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.yolo-labeler.app",
    "productName": "YOLO Labeler",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cupcc",
        "repo": "YOLO-Labeler"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "dependencies": {
    "electron-updater": "^6.7.3"
  }
}
